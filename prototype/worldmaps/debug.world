@areas[]  = debug-area-1(3-3)
@areas[]  = debug-area-1e(4-3)
@areas[]  = debug-area-1e2(5-3)
@areas[]  = debug-area-1n(3-2)
@areas[]  = debug-area-1n2(3-1)
@areas[]  = debug-area-1s(3-4)
@areas[]  = debug-area-1s2(3-5)
@areas[]  = debug-area-1sw(1-5)
@areas[]  = debug-area-1w(2-3)
@areas[]  = debug-area-1w2(1-3)
