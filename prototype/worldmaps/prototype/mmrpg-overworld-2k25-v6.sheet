#---------------------------#
# MMRPG OVERWORLD 2k25 SHEET
#---------------------------#
@token    = mmrpg-overworld-2k25-v6
@name     = MMRPG Overworld (2k25) (v6)
@image    = mmrpg-overworld-2k25_terrain-tiles-v6.png
@size     = 80 x 80
#---------------------------#
#---------------------------#
@tiles[]  = void(00, 40, 40, not-walkable)
@tiles[]  = dotted(01, 360, 40, not-walkable)
#---------------------------#
@sprites[]  = grid(120, 40)
@sprites[]  = hover(120, 40)
@sprites[]  = outline(360, 40)
